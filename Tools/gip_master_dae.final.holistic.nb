          RowBox[{"\"\<t_event\>\"", "->", 
           RowBox[{"N", "[", "tEvent", "]"}]}], ",", 
          RowBox[{"\"\<step_dist_mw\>\"", "->", 
           RowBox[{"N", "[", "stepDistMW", "]"}]}], ",", 
          RowBox[{"\"\<H_total_s\>\"", "->", "hTotal"}], ",", 
          RowBox[{"\"\<D_total_pu\>\"", "->", "dTotal"}], ",", 
          RowBox[{"\"\<R_eq_pu\>\"", "->", "rEq"}], ",", 
          RowBox[{"\"\<f_nadir_or_zenith_hz\>\"", "->", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"stepDistMW", ">=", "0"}], ",", 
             RowBox[{"Min", "[", "fSamples", "]"}], ",", 
             RowBox[{"Max", "[", "fSamples", "]"}]}], "]"}]}], ",", 
          RowBox[{"\"\<f_steady_hz\>\"", "->", 
           RowBox[{"fHzFunc", "[", 
            RowBox[{"N", "[", "tEnd", "]"}], "]"}]}], ",", 
          RowBox[{"\"\<f_hz_func\>\"", "->", "fHzFunc"}], ",", 
          RowBox[{"\"\<p_gen_delta_mw_func\>\"", "->", "pGenMWFunc"}], ",", 
          RowBox[{"\"\<p_bess_delta_mw_func\>\"", "->", "pBessMWFunc"}], ",", 
          RowBox[{"\"\<p_flex_delta_mw_func\>\"", "->", "pFlexMWFunc"}], ",", 
          RowBox[{"\"\<p_dist_mw_func\>\"", "->", "pDistMWFunc"}]}], 
         "|>"}]}]}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
