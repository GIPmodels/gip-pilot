              RowBox[{"All", ",", "\"\<p_mw\>\""}], "]"}], "]"}], "]"}], ",", 
           "0.0"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"totalLoadMVAr", "=", 
