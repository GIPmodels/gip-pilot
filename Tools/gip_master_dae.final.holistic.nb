           RowBox[{"<|", "|>"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"totalLoadMW", "=", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Length", "[", "perLoadEval", "]"}], ">", "0"}], ",", 
           RowBox[{"Total", "[", 
            RowBox[{
             RowBox[{"Values", "[", "perLoadEval", "]"}], "[", 
