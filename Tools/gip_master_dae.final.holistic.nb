            RowBox[{"Length", "[", "bessKeys", "]"}], ">", "0"}], ",", 
           RowBox[{"2.0", "*", 
            RowBox[{"Length", "[", "bessKeys", "]"}]}], ",", "0.0"}], "]"}]}],
         ";", "\[IndentingNewLine]", 
        RowBox[{"flexGainPuPerHz", "=", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Length", "[", "flexKeys", "]"}], ">", "0"}], ",", 
           RowBox[{"1.0", "*", 
            RowBox[{"Length", "[", "flexKeys", "]"}]}], ",", "0.0"}], "]"}]}],
         ";", "\[IndentingNewLine]", 
        RowBox[{"hTotal", "=", 
         RowBox[{"Max", "[", 
          RowBox[{"0.1", ",", 
           RowBox[{"hGenSum", "+", "hLoadSum"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"dTotal", "=", 
         RowBox[{"dGenSum", "+", "dMotorSum", "+", "dFreqSensPu"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"kSync", "=", "0.05"}], ";", "\[IndentingNewLine]", 
        RowBox[{"tGov", "=", "0.5"}], ";", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"pDistPu", "[", "t_", "]"}], ":=", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"N", "[", "stepDistMW", "]"}], "/", 
            RowBox[{"N", "[", "baseMVAVal", "]"}]}], ")"}], "*", 
          RowBox[{"(", 
           RowBox[{"0.5", "*", 
            RowBox[{"(", 
             RowBox[{"1.0", "+", 
              RowBox[{"Tanh", "[", 
               RowBox[{"20.0", "*", 
                RowBox[{"(", 
                 RowBox[{"t", "-", "tEvent"}], ")"}]}], "]"}]}], ")"}]}], 
           ")"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"eqs", "=", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"delta", "'"}], "[", "t", "]"}], "==", 
            RowBox[{"2.0", "*", "Pi", "*", 
             RowBox[{"N", "[", "fNomVal", "]"}], "*", 
             RowBox[{"dfPu", "[", "t", "]"}]}]}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"dfPu", "'"}], "[", "t", "]"}], "==", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"dPg", "[", "t", "]"}], "+", 
               RowBox[{"dPbess", "[", "t", "]"}], "+", 
               RowBox[{"dPflex", "[", "t", "]"}], "-", 
               RowBox[{"kSync", "*", 
                RowBox[{"delta", "[", "t", "]"}]}], "-", 
               RowBox[{"dTotal", "*", 
                RowBox[{"dfPu", "[", "t", "]"}]}], "-", 
               RowBox[{"pDistPu", "[", "t", "]"}]}], ")"}], "/", 
             RowBox[{"(", 
              RowBox[{"2.0", "*", "hTotal"}], ")"}]}]}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"dPg", "'"}], "[", "t", "]"}], "==", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{"-", 
                 RowBox[{"(", 
                  RowBox[{"1.0", "/", "rEq"}], ")"}]}], "*", 
                RowBox[{"dfPu", "[", "t", "]"}]}], "-", 
               RowBox[{"dPg", "[", "t", "]"}]}], ")"}], "/", "tGov"}]}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"dPbess", "'"}], "[", "t", "]"}], "==", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{"-", "bessGainPuPerHz"}], "*", 
                RowBox[{"dfPu", "[", "t", "]"}]}], "-", 
               RowBox[{"dPbess", "[", "t", "]"}]}], ")"}], "/", "0.08"}]}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"dPflex", "'"}], "[", "t", "]"}], "==", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{"-", "flexGainPuPerHz"}], "*", 
                RowBox[{"dfPu", "[", "t", "]"}]}], "-", 
               RowBox[{"dPflex", "[", "t", "]"}]}], ")"}], "/", "0.20"}]}]}], 
          "}"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"ic", "=", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"delta", "[", "0", "]"}], "==", "0.0"}], ",", 
           RowBox[{
            RowBox[{"dfPu", "[", "0", "]"}], "==", "0.0"}], ",", 
           RowBox[{
            RowBox[{"dPg", "[", "0", "]"}], "==", "0.0"}], ",", 
           RowBox[{
            RowBox[{"dPbess", "[", "0", "]"}], "==", "0.0"}], ",", 
           RowBox[{
            RowBox[{"dPflex", "[", "0", "]"}], "==", "0.0"}]}], "}"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"sol", "=", 
         RowBox[{"First", "[", 
          RowBox[{"NDSolve", "[", 
           RowBox[{
            RowBox[{"Join", "[", 
             RowBox[{"eqs", ",", "ic"}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{
             "delta", ",", "dfPu", ",", "dPg", ",", "dPbess", ",", "dPflex"}],
              "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"t", ",", "0.0", ",", 
              RowBox[{"N", "[", "tEnd", "]"}]}], "}"}]}], "]"}], "]"}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"fHzFunc", "=", 
         RowBox[{"Function", "[", 
          RowBox[{"tau", ",", 
           RowBox[{
            RowBox[{"N", "[", "fNomVal", "]"}], "*", 
            RowBox[{"(", 
             RowBox[{"1.0", "+", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"dfPu", "[", "tau", "]"}], "/.", " ", "sol"}], 
               ")"}]}], ")"}]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"pDistMWFunc", "=", 
         RowBox[{"Function", "[", 
          RowBox[{"tau", ",", 
           RowBox[{
            RowBox[{"pDistPu", "[", "tau", "]"}], "*", 
            RowBox[{"N", "[", "baseMVAVal", "]"}]}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"pGenMWFunc", "=", 
         RowBox[{"Function", "[", 
          RowBox[{"tau", ",", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"dPg", "[", "tau", "]"}], "/.", " ", "sol"}], ")"}], "*", 
            RowBox[{"N", "[", "baseMVAVal", "]"}]}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"pBessMWFunc", "=", 
         RowBox[{"Function", "[", 
          RowBox[{"tau", ",", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"dPbess", "[", "tau", "]"}], "/.", " ", "sol"}], ")"}], 
            "*", 
            RowBox[{"N", "[", "baseMVAVal", "]"}]}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"pFlexMWFunc", "=", 
         RowBox[{"Function", "[", 
