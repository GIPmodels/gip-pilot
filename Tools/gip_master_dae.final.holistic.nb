                "}"}], ",", 
               RowBox[{
                RowBox[{"nd", "=", 
                 RowBox[{"Association", "[", 
                  RowBox[{"nodesAssoc", "[", "k", "]"}], "]"}]}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"dVal", "=", 
                 RowBox[{"N", "[", 
                  RowBox[{"Lookup", "[", 
                   RowBox[{"nd", ",", "\"\<D\>\"", ",", "0.0"}], "]"}], 
                  "]"}]}], ";", "\[IndentingNewLine]", 
                RowBox[{"rVal", "=", 
