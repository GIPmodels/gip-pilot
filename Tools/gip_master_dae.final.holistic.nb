           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"dPflex", "[", "tau", "]"}], "/.", " ", "sol"}], ")"}], 
            "*", 
            RowBox[{"N", "[", "baseMVAVal", "]"}]}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"fSamples", "=", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"fHzFunc", "[", "tau", "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"tau", ",", "0.0", ",", 
             RowBox[{"N", "[", "tEnd", "]"}], ",", "0.01"}], "}"}]}], "]"}]}],
         ";", "\[IndentingNewLine]", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<t_end\>\"", "->", 
