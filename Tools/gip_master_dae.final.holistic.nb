                  RowBox[{"r", "=", 
                   RowBox[{"N", "[", 
                    RowBox[{"br", "[", "\"\<r\>\"", "]"}], "]"}]}], ",", 
                  RowBox[{"x", "=", 
                   RowBox[{"N", "[", 
                    RowBox[{"br", "[", "\"\<x\>\"", "]"}], "]"}]}], ",", "iu",
                   ",", "iv", ",", "vu", ",", "vv", ",", "dTh", ",", "gVal", ",",
