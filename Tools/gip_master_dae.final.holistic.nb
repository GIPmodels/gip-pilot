                    RowBox[{"N", "[", "rVal", "]"}]}], ",", "0.0"}], "]"}]}], 
                ";", "\[IndentingNewLine]", 
                RowBox[{"dVal", "+", "regTerm"}]}]}], "]"}]}], "]"}], "/@", 
           "keys"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
