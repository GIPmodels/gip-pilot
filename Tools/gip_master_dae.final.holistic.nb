            RowBox[{"Values", "[", "nodesAssoc", "]"}]}], "]"}], "]"}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"totalLossMW", "=", 
         RowBox[{"Total", "[", 
          RowBox[{"Map", "[", 
           RowBox[{
            RowBox[{"Function", "[", 
             RowBox[{"br", ",", 
