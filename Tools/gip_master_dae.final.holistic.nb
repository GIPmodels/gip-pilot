              RowBox[{"All", ",", "\"\<q_mvar\>\""}], "]"}], "]"}], "]"}], ",",
            "0.0"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"totalGenMW", "=", 
         RowBox[{"Total", "[", 
          RowBox[{"Map", "[", 
           RowBox[{
            RowBox[{"Function", "[", 
             RowBox[{"nd", ",", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"MemberQ", "[", 
                  RowBox[{
                   RowBox[{"{", 
                    
                    RowBox[{"\"\<Generator\>\"", ",", "\"\<PV\>\"", 
